{
  "name": "synapsedock",
  "version": "0.1.1",
  "private": true,
  "description": "A secure, provider-agnostic desktop workspace for persistent AI tasks and quota-aware failover.",
  "author": "SynapseDock",
  "license": "UNLICENSED",
  "homepage": "https://github.com/asgharssibil/synapsedock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asgharssibil/synapsedock.git"
  },
  "bugs": {
    "url": "https://github.com/asgharssibil/synapsedock/issues"
  },
  "main": "dist-electron/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/electron/main.js && cross-env UAIW_DEV_SERVER=1 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/electron-smoke.ps1",
    "build:icon": "node scripts/build-icon.mjs",
    "dist:win": "npm run build:icon && npm run build && electron-builder --win nsis --x64 --publish never",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-github-release.ps1",
    "release:win": "npm run dist:win && npm run release:prepare",
    "test:watch": "vitest",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.synapsedock.desktop",
    "productName": "SynapseDock",
    "copyright": "Copyright © 2026 SynapseDock. All rights reserved.",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SynapseDock-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SynapseDock",
      "uninstallDisplayName": "SynapseDock",
      "deleteAppDataOnUninstall": false
    }
  }
}
